# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
DB_PATH=./data/api-monitor.db

# Default monitoring settings
DEFAULT_INTERVAL_SECONDS=60
DEFAULT_TIMEOUT_MS=5000
DEFAULT_FAILURE_THRESHOLD=3
RETRY_COUNT=3
RETRY_BASE_DELAY_MS=250
RETRY_FACTOR=2

# Comma-separated probe kinds loaded at boot. The default image can also load
# tcp, tls, heartbeat, k8s.deployment, k8s.statefulset, k8s.cronjob, k8s.endpoints,
# and k8s.ingressCert. Database and queue kinds stay off until a later phase.
ENABLED_PROBES=http

# In-process MCP endpoint at POST /mcp
MCP_ENABLED=true

# disabled accepts every caller as admin. enabled requires Authorization: Bearer.
AUTH_MODE=disabled

# Public status links. Pages are served at {STATUS_BASE_URL}/status/{slug}.
STATUS_BASE_URL=http://localhost:3000

# Email alert routes. Leave SMTP_URL empty until a route of kind email exists.
SMTP_URL=
SMTP_FROM=

# Stateless MCP proxy. MCP_ONLY=true does not open SQLite.
# MONITOR_BASE_URL is the monitor. MCP_TOKEN is a read-scope API key.
MCP_ONLY=false
MONITOR_BASE_URL=
MCP_TOKEN=
