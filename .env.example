# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
DB_PATH=./data/api-monitor.db

# Default monitoring settings
DEFAULT_INTERVAL_SECONDS=60
DEFAULT_TIMEOUT_MS=5000
DEFAULT_FAILURE_THRESHOLD=3
RETRY_COUNT=3
RETRY_BASE_DELAY_MS=250
RETRY_FACTOR=2

# Comma-separated probe kinds loaded at boot. The default stays http.
# Also available in this image: tcp, tls, heartbeat, dns, domain, http.flow,
# postgres, mysql, mongodb, redis, s3, elastic, rabbitmq, sqlite, memcached, etcd,
# k8s.deployment, k8s.statefulset, k8s.cronjob, k8s.endpoints, k8s.ingressCert.
# Not loaded here: mssql, oracle, kafka, dynamodb, cosmos, sqs, pubsub, servicebus,
# azureblob, gcs, azureSearch, googleSearch.
# mysql covers MariaDB. Passwords go in secretRef, not in probe config.
ENABLED_PROBES=http

# In-process MCP endpoint at POST /mcp
MCP_ENABLED=true

# disabled accepts every caller as admin. enabled requires Authorization: Bearer.
AUTH_MODE=disabled

# Public status links. Pages are served at {STATUS_BASE_URL}/status/{slug}.
STATUS_BASE_URL=http://localhost:3000

# Raw health checks older than this many days are folded into hourly rollups.
RETENTION_RAW_DAYS=14

# sqlite probes may only open files inside this directory. Empty disables them.
SQLITE_PROBE_ROOT=

# Vision API directory. Off leaves monitor routes unchanged and answers /vision with 404.
# VISION_STAFF_TOKEN authorizes editorial review. A monitor API key does not.
VISION_MARKETPLACE_ENABLED=false
VISION_STAFF_TOKEN=
VISION_PUBLIC_RATE_LIMIT=60

# Publisher accounts and organization listings. Off leaves /account and /publisher as 404.
# A monitor API key does not sign in to the portal. VISION_STAFF_TOKEN remains the reviewer credential.
VISION_PUBLISHER_PORTAL_ENABLED=false

# Email alert routes. Leave SMTP_URL empty until a route of kind email exists.
SMTP_URL=
SMTP_FROM=

# Stateless MCP proxy. MCP_ONLY=true does not open SQLite.
# MONITOR_BASE_URL is the monitor. MCP_TOKEN is a read-scope API key.
MCP_ONLY=false
MONITOR_BASE_URL=
MCP_TOKEN=
